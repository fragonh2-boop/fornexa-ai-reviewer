# --- DeepSeek ---
# Genera la clave en https://platform.deepseek.com (Fran)
DEEPSEEK_API_KEY=
# Modelo a usar para revisión técnica independiente.
DEEPSEEK_MODEL=deepseek-v4-pro
# Tiempo máximo por llamada al modelo antes de fallar y liberar el trabajo.
DEEPSEEK_REQUEST_TIMEOUT_MS=180000

# --- Slack ---
# App propia en el workspace fornexasc.slack.com, con scopes:
#   channels:history, chat:write, channels:read
# (Bot Token, empieza por xoxb-)
SLACK_BOT_TOKEN=
# Basic Information → App Credentials → Signing Secret. Se usa para verificar
# criptográficamente cada POST de Slack Events antes de procesarlo.
SLACK_SIGNING_SECRET=
# ID del canal #fornexa (ya conocido: C0BT661FYLW)
SLACK_CHANNEL_ID=C0BT661FYLW
# Nombre que se muestra en los mensajes de handoff para identificar a esta IA
SLACK_AGENT_LABEL=DEEPSEEK
# Conversación por mención. Se activa por instancia solo cuando la app tenga
# identidad propia. El ID U… aparece en el perfil del bot en Slack.
SLACK_MENTIONS_ENABLED=false
SLACK_BOT_USER_ID=
# Token opcional de bot dedicado para publicar con la identidad del bot en el canal
# (ej. FornexaClaude). Si no se define, se usa SLACK_BOT_TOKEN (backward-compatible).
SLACK_BOT_CHANNEL_TOKEN=

# --- GitHub ---
# Fine-grained Personal Access Token, permisos MINIMOS:
#   Contents: Read-only
#   Pull requests: Read-only (reviews are returned in Slack)
#   Checks: Read-only
# Limitado exclusivamente al repo fragonh2-boop/Fornexa. NUNCA scope de Administration/Actions write.
GITHUB_TOKEN=
GITHUB_OWNER=fragonh2-boop
GITHUB_REPO=Fornexa

# --- Comportamiento del agente ---
# Intervalo del sondeo de respaldo; Slack Events es el camino principal.
POLL_INTERVAL_MINUTES=5
# Un candado más antiguo que este umbral se considera atascado y se recupera.
STALE_LOCK_MINUTES=15

# Shared provider transport; configure only the selected provider's key/model.
AI_PROVIDER=deepseek
AI_REQUEST_TIMEOUT_MS=180000
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# Disabled until dedicated credentials, author allowlist and durable storage exist.
IMPLEMENT_ENABLED=false
# This is a Slack-account allowlist, NOT proof of human authorship.
# Do not enable while agents can publish via an allowlisted human's user token.
# Agent-specific bot identities and removal of shared user-token access are required.
IMPLEMENT_SLACK_USER_IDS=
# Dedicated per-agent fine-grained PAT / installation token, ONLY the target repo.
# Contents: write; Pull requests: write; Metadata: read.
# No Administration, Actions write or Workflows write. Protect main without bypass.
# Never reuse GITHUB_TOKEN or a broad user/Codex PAT. Rotate any exposed credential.
GITHUB_WRITE_TOKEN=
IMPLEMENT_CHECKPOINT_DIR=

# --- Antigravity Local Sidecar (opcional) ---
# Token secreto compartido para autenticar el puente con el agente local de Antigravity en el Mac.
# Permite a @GeminiFornexa consultar git status, tests y ficheros locales cuando la máquina está activa.
# Si no está configurado, las herramientas cloud (clima, web) siguen disponibles 24/7.
SIDECAR_AUTH_TOKEN=
# Slack accounts allowed to invoke the explicit local sidecar route. Empty fails closed.
SIDECAR_SLACK_USER_IDS=

# --- Controlled Gemini Render deploy (interactive human approval) ---
# Only the fixed service fornexa-ai-reviewer-gemini and current main SHA are accepted.
# Use a dedicated credential with read access to this reviewer repo and Checks: read.
DEPLOY_GITHUB_TOKEN=
# Render API key: store only in the Gemini service, never in Slack or the model.
DEPLOY_RENDER_API_KEY=
# Slack users allowed to press the signed interactive approval button. API/user-token
# messages cannot emulate a Slack-signed block action.
DEPLOY_APPROVER_SLACK_USER_IDS=
DEPLOY_ENABLED=false

# --- Controlled Vercel production deploy for the product Fornexa ---
# Separate from the Render bot deploy. Exact main SHA and fixed team/project only.
# Read-only GitHub token scoped to fragonh2-boop/Fornexa, Contents + Checks read.
VERCEL_DEPLOY_GITHUB_TOKEN=
# Vercel token for the Fornexasc team, kept only on the Gemini Render service.
VERCEL_DEPLOY_API_TOKEN=
# Slack users allowed to press the signed interactive approval button.
VERCEL_DEPLOY_APPROVER_SLACK_USER_IDS=
VERCEL_DEPLOY_ENABLED=false
