# --- DeepSeek ---
# Genera la clave en https://platform.deepseek.com (Fran)
DEEPSEEK_API_KEY=
# Modelo a usar para revisión técnica independiente.
DEEPSEEK_MODEL=deepseek-v4-pro
# Tiempo máximo por llamada al modelo antes de fallar y liberar el trabajo.
DEEPSEEK_REQUEST_TIMEOUT_MS=180000

# --- Slack ---
# App propia en el workspace fornexasc.slack.com, con scopes:
#   channels:history, chat:write, channels:read
# (Bot Token, empieza por xoxb-)
SLACK_BOT_TOKEN=
# Basic Information → App Credentials → Signing Secret. Se usa para verificar
# criptográficamente cada POST de Slack Events antes de procesarlo.
SLACK_SIGNING_SECRET=
# ID del canal #fornexa (ya conocido: C0BT661FYLW)
SLACK_CHANNEL_ID=C0BT661FYLW
# Nombre que se muestra en los mensajes de handoff para identificar a esta IA
SLACK_AGENT_LABEL=DEEPSEEK

# --- GitHub ---
# Fine-grained Personal Access Token, permisos MINIMOS:
#   Contents: Read-only
#   Pull requests: Read-only (reviews are returned in Slack)
#   Checks: Read-only
# Limitado exclusivamente al repo fragonh2-boop/Fornexa. NUNCA scope de Administration/Actions write.
GITHUB_TOKEN=
GITHUB_OWNER=fragonh2-boop
GITHUB_REPO=Fornexa

# --- Comportamiento del agente ---
# Intervalo del sondeo de respaldo; Slack Events es el camino principal.
POLL_INTERVAL_MINUTES=5
# Un candado más antiguo que este umbral se considera atascado y se recupera.
STALE_LOCK_MINUTES=15

# Shared provider transport; configure only the selected provider's key/model.
AI_PROVIDER=deepseek
AI_REQUEST_TIMEOUT_MS=180000
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# Disabled until dedicated credentials, author allowlist and durable storage exist.
IMPLEMENT_ENABLED=false
IMPLEMENT_SLACK_USER_IDS=
GITHUB_WRITE_TOKEN=
IMPLEMENT_CHECKPOINT_DIR=
